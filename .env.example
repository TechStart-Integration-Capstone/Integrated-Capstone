# ==============================================================================
# PayPink 2.0 — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `docker/.env` to configure your environment to connect
# directly to the live hosted Azure Cloud SQL database.
#
# Azure SQL Database (Master Ledger & Retail Accounts):
AZURE_SQL_JDBC_URL=jdbc:sqlserver://paypink-sql.database.windows.net:1433;databaseName=paypink;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;authentication=SqlPassword
AZURE_SQL_USERNAME='paypink'
AZURE_SQL_PASSWORD='integrated@123'
AZURE_MANAGED_IDENTITY_CLIENT_ID=
