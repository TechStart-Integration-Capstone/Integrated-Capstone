          "uid": "prometheus"
        },
        "definition": "label_values(http_server_requests_seconds_count, job)",
        "query": "label_values(http_server_requests_seconds_count, job)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "name": "log_level",
        "label": "Log Level",
        "type": "custom",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "INFO", "value": "INFO" },
          { "selected": false, "text": "WARN", "value": "WARN" },
          { "selected": false, "text": "ERROR", "value": "ERROR" }
