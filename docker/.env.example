# Copy this file to docker/.env and replace the placeholders.
# Do not commit docker/.env; the root .gitignore excludes it.

# Azure-hosted runtime with system-assigned managed identity.
AZURE_SQL_JDBC_URL=jdbc:sqlserver://<server>.database.windows.net:1433;databaseName=<database>;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;authentication=ActiveDirectoryMSI

# For user-assigned managed identity, set this value and add msiClientId=<client-id>
# to AZURE_SQL_JDBC_URL.
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# Replace for non-local environments.
JWT_SECRET=change-this-to-a-long-random-secret
