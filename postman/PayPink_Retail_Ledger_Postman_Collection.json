              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"X-Correlation-ID auto-generated UUID in response\", function () {",
                  "    var id = pm.response.headers.get('X-Correlation-ID');",
                  "    pm.expect(id).to.be.a('string');",
                  "    pm.expect(id.length).to.be.above(10);",
                  "    pm.environment.set('last_correlation_id', id);",
