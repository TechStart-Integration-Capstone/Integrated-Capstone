    {
      "name": "8. Phase 3 — Risk Engine (Python FastAPI)",
      "item": [
        {
          "name": "GET Risk Engine Health (no JWT needed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.test(\"status UP\", () => pm.expect(j.status).to.eql('UP'));",
                  "pm.test(\"service is risk-engine\", () => pm.expect(j.service).to.eql('risk-engine'));",
                  "pm.test(\"version is 2.0.0\", () => pm.expect(j.version).to.eql('2.0.0'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/risk/health",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "risk", "health"]
            }
          }
        },
        {
          "name": "POST Score — Low Risk (5k PHP) → APPROVE score=0.0",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.test(\"decision is APPROVE\", () => pm.expect(j.decision).to.eql('APPROVE'));",
                  "pm.test(\"score is 0.0\", () => pm.expect(j.score).to.eql(0.0));",
                  "pm.test(\"reasons contains no_risk_signals\", () => pm.expect(j.reasons).to.include('no_risk_signals'));",
                  "pm.test(\"latencyMs under 200ms\", () => pm.expect(j.latencyMs).to.be.below(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
