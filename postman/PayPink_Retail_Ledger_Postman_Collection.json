    {
      "name": "3. Core Ledger Mutation (/api/v1/ledger/mutate)",
      "item": [
        {
          "name": "POST Valid DEBIT Mutation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.environment.set(\"idemp_key\", \"IDEMP-POSTMAN-\" + Date.now());"],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.test(\"Status SUCCESS\", () => pm.expect(j.status).to.eql('SUCCESS'));",
                  "pm.test(\"cachedIdempotentResponse is false (first call)\", () => pm.expect(j.cachedIdempotentResponse).to.be.false);",
                  "pm.test(\"referenceNo present\", () => pm.expect(j.referenceNo).to.be.a('string'));",
                  "pm.test(\"afterBalance is number\", () => pm.expect(j.afterBalance).to.be.a('number'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idemp_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": 1,\n  \"mutationAmount\": 150.5000,\n  \"operation\": \"DEBIT\",\n  \"transactionType\": \"TRANSFER_INSTAPAY\",\n  \"targetAccountId\": 4,\n  \"currency\": \"PHP\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ledger/mutate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ledger", "mutate"]
            }
          }
        },
        {
          "name": "POST Redis Idempotency Duplicate Replay (same key — must return cached)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.test(\"cachedIdempotentResponse is TRUE (Redis hit)\", () => pm.expect(j.cachedIdempotentResponse).to.be.true);",
                  "pm.test(\"Response time under 50ms (Redis)\", () => pm.expect(pm.response.responseTime).to.be.below(50));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idemp_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": 1,\n  \"mutationAmount\": 150.5000,\n  \"operation\": \"DEBIT\",\n  \"transactionType\": \"TRANSFER_INSTAPAY\",\n  \"targetAccountId\": 4,\n  \"currency\": \"PHP\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ledger/mutate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ledger", "mutate"]
            }
          }
        },
        {
          "name": "POST Boundary Fault: 5 Decimals (400 expected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "var j = pm.response.json();",
                  "pm.test(\"RFC-7807 validation error\", () => pm.expect(j.type).to.include('validation'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"accountId\": 1,\n  \"mutationAmount\": 100.12345,\n  \"operation\": \"DEBIT\",\n  \"currency\": \"PHP\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/ledger/mutate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ledger", "mutate"]
            }
          }
        },
        {
          "name": "POST Boundary Fault: Negative Amount (400 expected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"accountId\": 1,\n  \"mutationAmount\": -50.0000,\n  \"operation\": \"DEBIT\",\n  \"currency\": \"PHP\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/ledger/mutate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ledger", "mutate"]
            }
          }
        },
        {
          "name": "POST Overdraft Protection: Insufficient Funds (422 expected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 422\", () => pm.response.to.have.status(422));",
                  "var j = pm.response.json();",
                  "pm.test(\"RFC-7807 insufficient-funds\", () => pm.expect(j.type).to.include('insufficient'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"accountId\": 3,\n  \"mutationAmount\": 9999999.0000,\n  \"operation\": \"DEBIT\",\n  \"currency\": \"PHP\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/ledger/mutate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ledger", "mutate"]
            }
          }
        }
      ]
