{
  "info": {
    "_postman_id": "8f3b2c1a-7d4e-4f9a-9e12-3b4c5d6e7f8a",
    "name": "PayPink 2.0 — Core Retail Ledger & Risk Engine",
    "description": "Full test suite for PayPink Capstone 1 + Capstone 2 (Phase 0–3). Covers: JWT auth, account queries (with mayBeStale circuit breaker), ledger mutations, idempotency, stress tests, reconciliation, telemetry, X-Correlation-ID verification, and the Phase 3 Risk Engine scoring API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Security (Perimeter Layer)",
      "item": [
        {
          "name": "POST Login & Generate JWT Token (lviernes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"JWT token received\", function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.environment.set(\"jwt_token\", jsonData.token);",
                  "});",
                  "pm.test(\"X-Correlation-ID present in response\", function () {",
                  "    pm.expect(pm.response.headers.get('X-Correlation-ID')).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"lviernes\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
